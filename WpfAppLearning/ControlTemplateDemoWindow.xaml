<Window x:Class="WpfAppLearning.ControlTemplateDemoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Control Template Demo" Height="600" Width="900">

    <ScrollViewer>
        <StackPanel Margin="20">

            <TextBlock Text="WPF Control Templates Demonstration"
                       FontSize="28" FontWeight="Bold" Margin="0 0 0 20"/>

            <!-- =========================================================
                 1. DEFAULT BUTTON (to show difference)
            =========================================================== -->
            <GroupBox Header="1. Default WPF Button" Margin="0 0 0 20">
                <StackPanel Margin="10">
                    <Button Content="Default Button" Width="150" Height="40" />
                    <TextBlock Text="This is how WPF defines button by default (Border + ContentPresenter)."
                               Foreground="Gray" TextWrapping="Wrap"/>
                </StackPanel>
            </GroupBox>


            <!-- =========================================================
                 2. SIMPLE CUSTOM TEMPLATE (FLAT BUTTON)
            =========================================================== -->
            <GroupBox Header="2. Simple Flat Button Template" Margin="0 0 0 20">

                <StackPanel Margin="10">

                    <StackPanel.Resources>

                        <ControlTemplate x:Key="FlatButtonTemplate" TargetType="Button">
                            <Border Background="LightSkyBlue"
                                    CornerRadius="4"
                                    Padding="10">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>

                    </StackPanel.Resources>

                    <Button Template="{StaticResource FlatButtonTemplate}"
                            Content="Flat Styled Button"
                            Width="180" Height="40"/>

                    <TextBlock Text="This template makes the button flat by replacing the default Border with a custom one."
                               Foreground="Gray" TextWrapping="Wrap" Margin="0 10 0 0"/>

                </StackPanel>
            </GroupBox>


            <!-- =========================================================
                 3. ROUNDED BUTTON WITH TEMPLATEBINDING
            =========================================================== -->
            <GroupBox Header="3. Rounded Button + TemplateBinding (Important)" Margin="0 0 0 20">

                <StackPanel Margin="10">

                    <StackPanel.Resources>

                        <ControlTemplate x:Key="RoundedButton" TargetType="Button">

                            <!-- TemplateBinding copies values from the control -->
                            <Border Background="{TemplateBinding Background}"
                                    CornerRadius="30"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                            </Border>

                        </ControlTemplate>

                    </StackPanel.Resources>

                    <Button Content="Rounded Button"
                            Background="Orange"
                            Padding="12"
                            Template="{StaticResource RoundedButton}"
                            Width="200" Height="50"/>

                    <TextBlock Text="TemplateBinding allows the template to use the Button’s properties (Background, Padding)."
                               Foreground="Gray" TextWrapping="Wrap" Margin="0 10 0 0"/>

                </StackPanel>
            </GroupBox>


            <!-- =========================================================
                 4. BUTTON WITH HOVER + PRESSED STATES (TRIGGERS)
            =========================================================== -->
            <GroupBox Header="4. Button With Hover and Press Visual States" Margin="0 0 0 20">

                <StackPanel Margin="10">

                    <StackPanel.Resources>

                        <ControlTemplate x:Key="InteractiveButton" TargetType="Button">
                            <Border x:Name="border"
                                    Background="LightGray"
                                    CornerRadius="6"
                                    Padding="10">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                            </Border>

                            <ControlTemplate.Triggers>

                                <!-- Hover -->
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="LightBlue"/>
                                </Trigger>

                                <!-- Pressed -->
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="LightGreen"/>
                                </Trigger>

                                <!-- Disabled -->
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="border" Property="Opacity" Value="0.5"/>
                                </Trigger>

                            </ControlTemplate.Triggers>
                        </ControlTemplate>

                    </StackPanel.Resources>

                    <Button Template="{StaticResource InteractiveButton}"
                            Content="Hover / Press Me"
                            Width="200" Height="50"/>

                    <TextBlock Text="Triggers let you change visuals based on Button states (Hover, Pressed, Disabled)."
                               Foreground="Gray" TextWrapping="Wrap" Margin="0 10 0 0"/>

                </StackPanel>

            </GroupBox>


        </StackPanel>
    </ScrollViewer>

</Window>
