<Page x:Class="WpfAppLearning.PeoplePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="3*"/>
        </Grid.RowDefinitions>

        <!-- TOP LIST -->
        <ListBox Grid.Row="0"
                 ItemsSource="{Binding People}"
                 SelectedItem="{Binding SelectedPerson}"
                 BorderBrush="DarkGray" BorderThickness="1" Margin="5">

            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="Gray" BorderThickness="1"
                            Padding="10" Margin="5" CornerRadius="6">
                        <StackPanel>
                            <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="Bold"/>
                            <TextBlock Text="{Binding Age}" />
                            <TextBlock Text="{Binding Email}" />
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>

        </ListBox>

        <!-- DETAILS -->
        <Border Grid.Row="1"
                BorderBrush="DarkGray" BorderThickness="1"
                CornerRadius="8" Padding="10" Margin="5">

            <StackPanel VerticalAlignment="Top">

                <TextBlock Text="Selected Person Details"
                           FontSize="18" FontWeight="Bold" Margin="0 0 0 10"/>

                <StackPanel Margin="10">
                    <TextBlock Text="Name:" />
                    <TextBox Text="{Binding SelectedPerson.Name, Mode=TwoWay}" Width="250"/>
                </StackPanel>

                <StackPanel Margin="10">
                    <TextBlock Text="Age:" />
                    <TextBox Text="{Binding SelectedPerson.Age, Mode=TwoWay}" Width="250"/>
                </StackPanel>

                <StackPanel Margin="10">
                    <TextBlock Text="Email:" />
                    <TextBox Text="{Binding SelectedPerson.Email, Mode=TwoWay}" Width="250"/>
                </StackPanel>

                <Button Content="Add Person"
                        Width="150"
                        Margin="10"
                        Command="{Binding AddPersonCommand}" />

            </StackPanel>
        </Border>
    </Grid>
</Page>
