<Window x:Class="WpfAppLearning.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctrl="clr-namespace:WpfAppLearning.Controls"
        Title="MainWindow" Height="700" Width="1000">

    <Grid Margin="10">

        <!-- GRID SETUP: 2 COLUMNS -->
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="400"/>
            <!-- LEFT MENU PANEL -->
            <ColumnDefinition Width="*"/>
            <!-- RIGHT MAIN AREA -->
        </Grid.ColumnDefinitions>


        <!-- ==========================================================
             LEFT MENU PANEL (COLUMN 0)
        ========================================================== -->
        <Border Grid.Column="0" 
                BorderBrush="DarkGray" BorderThickness="1" CornerRadius="8" Padding="10">
            <StackPanel>

                <TextBlock Text="Demo Navigation"
                           FontSize="16" FontWeight="Bold"
                           Margin="0 0 0 10"/>

                <Button Content="Binding Demo"
                        Margin="0 5" Height="40"
                        Click="OpenBindingDemo_Click" />

                <Button Content="Data Template Demo"
                        Margin="0 5" Height="40"
                        Click="OpenDataTemplateDemo_Click" />

                <Button Content="Control Template Demo"
                        Margin="0 5" Height="40"
                        Click="OpenControlTemplateDemo_Click" />

                <Button Content="VS Layout Demo"
                        Margin="0 5" Height="40"
                        IsEnabled="true" Click="OpenVSLayout_Click" />

                <TextBlock Text="Custom Controls (Date Picker)"
                           FontSize="12" FontWeight="Light"/>  
                <ctrl:DateTimePicker Value="{Binding SomeDate}" Margin="20"/>

                <TextBlock Text="Default WPF DatePicker"
           FontSize="12" FontWeight="Light"
           Margin="0 10 0 0"/>

                <DatePicker SelectedDate="{Binding SomeDate}"
            Margin="20"
            Width="200"/>
                <Button Content="Async + Dispatcher Demo"
                        Margin="0 5" Height="40"
                        IsEnabled="true"
                        Click="DispatcherDemo_Click" />
                <Button Content="WPF Notes!"
                        Margin="0 5" Height="40"
                        IsEnabled="true"
                        Click="OpenNotesPage_Click"/> 
            </StackPanel>
        </Border>



        <!-- ==========================================================
             RIGHT PANEL (COLUMN 1) WITH TWO ROWS
        ========================================================== -->
        <Grid Grid.Column="1" Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="2*"/>
                <!-- List -->
                <RowDefinition Height="3*"/>
                <!-- Details -->
            </Grid.RowDefinitions>

            <!-- ============================
                 TOP ROW → LIST OF PEOPLE
            ============================ -->
            <Frame x:Name="MainFrame"
                       Grid.Column="1"
                       Grid.RowSpan="2"
                       NavigationUIVisibility="Hidden"/>    
        </Grid>
    </Grid>
</Window>
