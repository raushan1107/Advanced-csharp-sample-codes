<Window x:Class="WpfApp_1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp_1"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <StackPanel Margin="30">
        <Button Content="Run Synchronous Work" Click="Sync_Click" Margin="5" Height="40"/>
        <Button Content="Run Asynchronous Work" Click="Async_Click" Margin="5" Height="40"/>
        <Button Content="Check UI Responsiveness" Click="Ping_Click" Margin="5" Height="40"/>
            <Button Content="Async Without Thread (Delay Demo)"
        Height="40" Margin="5"
        Click="AsyncWithoutThread_Click"/>
        <Button Name="btnLoadData" Content="Load Data" Margin="5" Height="40" Click="Button_Click"/>
    </StackPanel>
    </Grid>
    
</Window>
